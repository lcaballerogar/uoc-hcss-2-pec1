{
  "name": "uoc-hcss-2-pec1",
  "version": "3.14.0",
  "private": true,
  "description": "Blink Case Study — Motion design, visual identity, desktop web & app UI design.",
  "scripts": {
    "parcel:serve": "parcel -p 8123 --target web",
    "parcel:build": "parcel build --target web --no-source-maps --no-cache",
    "clean": "rimraf dist .cache .cache-loader .parcel-cache",
    "stylelint": "stylelint src/**/*.scss",
    "dev": "npm-run-all clean parcel:serve",
    "build": "npm-run-all clean stylelint parcel:build",
    "test": "echo 'Everything is working as expected ✅\nStart working on your project by running \\033[1mnpm run dev\\033[0m'"
  },
  "targets": {
    "web": {
      "context": "browser",
      "publicUrl": "./",
      "source": "src/index.html",
      "engines": {
        "browsers": "last 2 versions, > 0.5%, not dead"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lcaballerogar/uoc-hcss-2-pec1.git"
  },
  "author": {
    "name": "Laura Caballero García",
    "email": "lcaballerogar@uoc.edu"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lcaballerogar/uoc-hcss-2-pec1/issues"
  },
  "homepage": "https://uoc-hcss-2-pec1.netlify.app/",
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.4",
    "autoprefixer": "^10.5.5",
    "npm-run-all": "^4.1.5",
    "parcel": "^2.16.4",
    "postcss-preset-env": "^11.5.1",
    "posthtml-include": "^2.0.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.33.5",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-scss": "^7.3.0"
  }
}
